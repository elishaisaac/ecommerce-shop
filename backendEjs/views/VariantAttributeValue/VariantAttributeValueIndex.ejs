<%- include("../partials/HeadSection.ejs") %>
    <div class="card mb-4">
        <div class="card-header">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <h3 class="card-title">Variant Attribute Values List</h3>
                </div>
                <div class="col-12 col-md-8">
                    <div class="d-flex flex-wrap justify-content-md-end gap-2">
                        <div class="input-group input-group-sm w-auto">
                            <span class="input-group-text">
                                <i class="bi bi-search" aria-hidden="true"></i>
                            </span>
                            <input type="search" id="user-search" class="form-control"
                                placeholder="Search Variant Attribute Values" aria-label="Search users"
                                style="width: 180px" />
                        </div>
                        <select id="user-role-filter" class="form-select form-select-sm w-auto"
                            aria-label="Filter by role">
                            <option value="all" selected>All roles</option>
                            <option value="administrator">Administrator</option>
                            <option value="editor">Editor</option>
                            <option value="author">Author</option>
                            <option value="subscriber">Subscriber</option>
                        </select>
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#modal-add-variantAttributeValue">
                            <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                            New Variant Attribute Value
                        </button>
                        <!-- data-bs-toggle="modal" -->
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <!-- <th>Product Actual Price</th> -->
                            <th>Product / Variant</th>
                            <th>Atribute Name</th>
                            <th>Atribute Value</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data.length> 0) { %>
                            <% data.forEach((item, index)=> { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <%= index + 1 %>
                                        </div>
                                    </td>
                                    <td>
                                        <%= item.productVariantFID.productFID?.productName %> — <%=
                                                item.productVariantFID.productSKU %>
                                    </td>
                                    <td>
                                        <%= item.attributeFID.attributeName %>
                                    </td>
                                    <td>
                                        <%= item.attributeValueFID.attributeValue %>
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modal-edit-variantAttributeValue-<%= item._id %>">
                                                <i class="bi bi-pencil" aria-hidden="true"> </i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal"
                                                data-bs-target="#modal-delete-variantAttributeValue-<%= item._id %>">
                                                <i class="bi bi-trash" aria-hidden="true"> </i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <!--begin::Edit Variant Attribute Value Modal-->
                                <div class="modal fade" id="modal-edit-variantAttributeValue-<%= item._id %>"
                                    tabindex="-1" aria-labelledby="modal-edit-variantAttributeValue-label"
                                    aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form
                                                action="/api/variantAttributeValue/updateVariantAttributeValue/<%= item._id %>"
                                                method="post">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="modal-edit-variantAttributeValue-label">
                                                        Edit
                                                        Variant Attribute Value</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                        aria-label="Close"></button>
                                                </div>

                                                <div class="modal-body">
                                                    <!-- <div class="mb-3">
                                                        <label for="productVariantFID" class="form-label">Product Actual
                                                            Price</label>
                                                        <select id="new-user-role" name="productVariantFID"
                                                            class="form-select">
                                                            <option value="<%= item.productVariantFID._id%>" selected>
                                                                <%= item.productVariantFID.productActualPrice %>
                                                            </option>
                                                            <% ProductVariants.forEach((productVariant)=> {%>
                                                                <option value="<%= productVariant._id%>">
                                                                    <%= productVariant.productActualPrice %>
                                                                </option>
                                                                <%})%>
                                                        </select>
                                                    </div> -->
                                                    <div class="mb-3">
                                                        <label for="productVariantFID" class="form-label">Product
                                                            Variant</label>
                                                        <select id="new-user-role" name="productVariantFID"
                                                            class="form-select">
                                                            <option value="<%= item.productVariantFID._id %>" selected>
                                                                <%= item.productVariantFID.productFID?.productName %> —
                                                                    <%= item.productVariantFID.productSKU %>
                                                            </option>
                                                            <% ProductVariants.forEach((productVariant)=> { %>
                                                                <option value="<%= productVariant._id %>">
                                                                    <%= productVariant.productFID?.productName %> — <%=
                                                                            productVariant.productSKU %> (Rs. <%=
                                                                                productVariant.productSalePrice %>)
                                                                </option>
                                                                <% }) %>
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="attributeFID" class="form-label"> Attribute Name
                                                        </label>
                                                        <select id="new-user-role" name="attributeFID"
                                                            class="form-select">
                                                            <option value="<%= item.attributeFID._id%>" selected>
                                                                <%= item.attributeFID.attributeName %>
                                                            </option>
                                                            <% Attributes.forEach((attribute)=> {%>
                                                                <option value="<%= attribute._id%>">
                                                                    <%= attribute.attributeName %>
                                                                </option>
                                                                <%})%>
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="attributeValueFID" class="form-label"> Attribute
                                                            Value</label>
                                                        <select id="new-user-role" name="attributeValueFID"
                                                            class="form-select">
                                                            <option value="<%= item.attributeValueFID._id%>" selected>
                                                                <%= item.attributeValueFID.attributeValue %>
                                                            </option>
                                                            <% AttributeValues.forEach((attributeValue)=> {%>
                                                                <option value="<%= attributeValue._id%>">
                                                                    <%= attributeValue.attributeValue %>
                                                                </option>
                                                                <%})%>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary"
                                                        data-bs-dismiss="modal">
                                                        Cancel
                                                    </button>
                                                    <button type="submit" class="btn btn-primary">Update
                                                        Variant Attribute Value</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Edit Variant Attribute Value Modal-->

                                <!--begin::Delete Variant Attribute Value Modal-->
                                <div class="modal fade" id="modal-delete-variantAttributeValue-<%= item._id %>"
                                    tabindex="-1" aria-labelledby="modal-delete-variantAttributeValue-label"
                                    aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="modal-delete-variantAttributeValue-label">
                                                    Delete
                                                    Variant Attribute Value
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                    aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="mb-0">
                                                    Are you sure you want to delete this Variant Attribute Value?
                                                    This action cannot be undone.
                                                </p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    Cancel
                                                </button>
                                                <form
                                                    action="/api/variantAttributeValue/deleteVariantAttributeValue/<%= item._id %>"
                                                    method="post">
                                                    <button type="submit" class="btn btn-danger"
                                                        data-bs-dismiss="modal">
                                                        Delete Variant Attribute Value
                                                    </button>
                                                </form>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Delete Variant Attribute Value Modal-->
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="text-center py-5">
                                                <h5 class="text-muted">
                                                    No Variant Attribute Value Found
                                                </h5>
                                                <p class="text-muted mb-3">
                                                    Start by adding your first Variant Attribute Value.
                                                </p>
                                                <button type="button" class="btn btn-sm btn-primary"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modal-add-variantAttributeValue">
                                                    <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                                                    Add Variant Attribute Value
                                                </button>
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
            <!-- /.table-responsive -->
        </div>
    </div>

    <!--begin::Add User Modal-->
    <div class="modal fade" id="modal-add-variantAttributeValue" tabindex="-1"
        aria-labelledby="modal-add-variantAttributeValue-label" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/api/variantAttributeValue" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modal-add-variantAttributeValue-label">Add new Variant Attribute
                            Value</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="productVariantFID" class="form-label">Product Variant</label>
                            <select id="new-user-role" name="productVariantFID" class="form-select" required>
                                <option value="" selected disabled>Select Product Variant</option>
                                <% ProductVariants.forEach((productVariant)=> { %>
                                    <option value="<%= productVariant._id %>">
                                        <%= productVariant.productFID?.productName %> — <%= productVariant.productSKU %>
                                                (Rs. <%= productVariant.productSalePrice %>)
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <!-- <div class="mb-3">
                            <label for="productVariantFID" class="form-label">
                                Product Variant
                            </label>

                            <select id="productVariantFID" name="productVariantFID" class="form-select" required>
                                <option value="" selected disabled>
                                    Select Product Variant
                                </option>

                                <% ProductVariants.forEach((productVariant)=> { %>
                                    <option value="<%= productVariant._id %>">
                                        Actual Price: <%= productVariant.productActualPrice %>
                                            | Sale Price: <%= productVariant.productSalePrice %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div> -->
                        <div class="mb-3">
                            <div class="mb-3">
                                <label for="attributeFID" class="form-label"> Attribute Name </label>
                                <select id="new-user-role" name="attributeFID" class="form-select">
                                    <option selected>Select Attribute Name</option>
                                    <% Attributes.forEach((attribute)=> {%>
                                        <option value="<%= attribute._id%>">
                                            <%= attribute.attributeName %>
                                        </option>
                                        <%})%>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="mb-3">
                                <label for="attributeValueFID" class="form-label"> Attribute Value </label>
                                <select id="new-user-role" name="attributeValueFID" class="form-select">
                                    <option selected>Select Attribute Value</option>
                                    <% AttributeValues.forEach((attributeValueFID)=> {%>
                                        <option value="<%= attributeValueFID._id%>">
                                            <%= attributeValueFID.attributeValue %>
                                        </option>
                                        <%})%>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary">Create Variant Attribute Value</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!--end::Add User Modal-->

    <%- include("../partials/Footer.ejs") %>