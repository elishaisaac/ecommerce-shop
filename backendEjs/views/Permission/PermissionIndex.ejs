<%- include("../partials/HeadSection.ejs") %>
    <div class="card mb-4">
        <div class="card-header">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <h3 class="card-title">Permission List</h3>
                </div>
                <div class="col-12 col-md-8">
                    <div class="d-flex flex-wrap justify-content-md-end gap-2">
                        <div class="input-group input-group-sm w-auto">
                            <span class="input-group-text">
                                <i class="bi bi-search" aria-hidden="true"></i>
                            </span>
                            <input type="search" id="user-search" class="form-control" placeholder="Search Permissions"
                                aria-label="Search users" style="width: 180px" />
                        </div>
                                                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#modal-add-permission">
                            <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                            New Permission
                        </button>
                        <!-- data-bs-toggle="modal" -->
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Permission Action</th>
                            <th>Permission Resourse</th>
                            <th>Permission Description</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data.length> 0) { %>
                            <% data.forEach((item, index)=> { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <%= index + 1 %>
                                        </div>
                                    </td>
                                    <td>
                                        <%= item.permissionAction %>
                                    </td>
                                    <td>
                                        <%= item.permissionResourse %>
                                    </td>
                                    <td>
                                        <%= item.permissionDescription %>
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modal-edit-permission-<%= item._id %>">
                                                <i class="bi bi-pencil" aria-hidden="true"> </i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal"
                                                data-bs-target="#modal-delete-permission-<%= item._id %>">
                                                <i class="bi bi-trash" aria-hidden="true"> </i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <!--begin::Edit Permission Modal-->
                                <div class="modal fade" id="modal-edit-permission-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-edit-permission-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form action="/api/permission/updatepermission/<%= item._id %>" method="post">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="modal-edit-permission-label">Edit
                                                        Permission</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                        aria-label="Close"></button>
                                                </div>

                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label for="permissionAction" class="form-label">Permission
                                                            Action</label>
                                                        <input type="text" class="form-control" name="permissionAction"
                                                            value="<%= item.permissionAction %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="permissionResourse" class="form-label">Permission
                                                            Resourse</label>
                                                        <input type="text" class="form-control" name="permissionResourse"
                                                            value="<%= item.permissionResourse %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="permissionDescription" class="form-label">Permission
                                                            Description</label>
                                                        <input type="text" class="form-control" name="permissionDescription"
                                                            value="<%= item.permissionDescription %>" required />
                                                    </div>
                                                   
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary"
                                                        data-bs-dismiss="modal">
                                                        Cancel
                                                    </button>
                                                    <button type="submit" class="btn btn-primary">Update
                                                        Permission</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Edit Permission Modal-->

                                <!--begin::Delete Permission Modal-->
                                <div class="modal fade" id="modal-delete-permission-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-delete-permission-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="modal-delete-permission-label">Delete Permission
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                    aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="mb-0">
                                                    Are you sure you want to delete this Permission?
                                                    This action cannot be undone.
                                                </p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    Cancel
                                                </button>
                                                <form action="/api/permission/deletepermission/<%= item._id %>" method="post">
                                                    <button type="submit" class="btn btn-danger"
                                                        data-bs-dismiss="modal">
                                                        Delete Permission
                                                    </button>
                                                </form>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Delete Permission Modal-->
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="text-center py-5">
                                                <h5 class="text-muted">
                                                    No Permission Found
                                                </h5>
                                                <p class="text-muted mb-3">
                                                    Start by adding your first Permission.
                                                </p>
                                                <button type="button" class="btn btn-sm btn-primary"
                                                    data-bs-toggle="modal" data-bs-target="#modal-add-permission">
                                                    <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                                                    Add Permission
                                                </button>
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
            <!-- /.table-responsive -->
        </div>
    </div>

    <!--begin::Add User Modal-->
    <div class="modal fade" id="modal-add-permission" tabindex="-1" aria-labelledby="modal-add-permission-label"
        aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/api/permission" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modal-add-permission-label">Add new Permission</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="permissionAction" class="form-label">Permission Action</label>
                            <input type="text" class="form-control" name="permissionAction" placeholder="Enter Permission Action"
                                required />
                        </div>
                        <div class="mb-3">
                            <label for="permissionResourse" class="form-label">Permission Resourse</label>
                            <input type="text" class="form-control" name="permissionResourse" placeholder="Enter Permission Resourse"
                                required />
                        </div>
                        <div class="mb-3">
                            <label for="permissionDescription" class="form-label">Permission Description</label>
                            <input type="text" class="form-control" name="permissionDescription"
                                placeholder="Enter permission Description" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary">Create Permission</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!--end::Add User Modal-->

    <%- include("../partials/Footer.ejs") %>