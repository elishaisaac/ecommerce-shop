<%- include("../partials/HeadSection.ejs") %>
    <div class="card mb-4">
        <div class="card-header">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <h3 class="card-title">OrderedItem List</h3>
                </div>
                <div class="col-12 col-md-8">
                    <div class="d-flex flex-wrap justify-content-md-end gap-2">
                        <div class="input-group input-group-sm w-auto">
                            <span class="input-group-text">
                                <i class="bi bi-search" aria-hidden="true"></i>
                            </span>
                            <input type="search" id="user-search" class="form-control" placeholder="Search OrderedItems"
                                aria-label="Search users" style="width: 180px" />
                        </div>
                        <select id="user-role-filter" class="form-select form-select-sm w-auto"
                            aria-label="Filter by role">
                            <option value="all" selected>All roles</option>
                            <option value="administrator">Administrator</option>
                            <option value="editor">Editor</option>
                            <option value="author">Author</option>
                            <option value="subscriber">Subscriber</option>
                        </select>
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#modal-add-orderedItem">
                            <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                            New OrderedItem
                        </button>
                        <!-- data-bs-toggle="modal" -->
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Order Number</th>
                            <th>Product SKU</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Total Price</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data.length> 0) { %>
                            <% data.forEach((item, index)=> { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <%= index + 1 %>
                                        </div>
                                    </td>
                                    <td>
                                        <%= item.orderFID.orderNumber %>
                                    </td>
                                    <td>
                                        <%= item.productVariantFID.productSKU %>
                                    </td>
                                    <td>
                                        <%= item.itemQuantity %>
                                    </td>
                                    <td>
                                        <%= item.itemUnitPrice %>
                                    </td>
                                    <td>
                                        <%= item.itemTotalPrice %>
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modal-edit-orderedItem-<%= item._id %>">
                                                <i class="bi bi-pencil" aria-hidden="true"> </i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal"
                                                data-bs-target="#modal-delete-orderedItem-<%= item._id %>">
                                                <i class="bi bi-trash" aria-hidden="true"> </i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <!--begin::Edit OrderedItem Modal-->
                                <div class="modal fade" id="modal-edit-orderedItem-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-edit-orderedItem-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form action="/api/orderedItem/updateorderedItem/<%= item._id %>" method="post">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="modal-edit-orderedItem-label">Edit
                                                        OrderedItem</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                        aria-label="Close"></button>
                                                </div>

                                                <div class="modal-body">
                                                   <div class="mb-3">
                                                        <label for="orderFID" class="form-label"> Order Number
                                                        </label>
                                                        <select id="new-orderedItem-order" name="orderFID"
                                                            class="form-select">
                                                            <option value="<%= item.orderFID._id%>" selected>
                                                                <%= item.orderFID.orderNumber %>
                                                            </option>
                                                            <% Orders.forEach((order)=> {%>
                                                                <option value="<%= order._id%>">
                                                                    <%= order.orderNumber %>
                                                                </option>
                                                                <%})%>
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="productVariantFID" class="form-label"> Product SKU
                                                        </label>
                                                        <select id="new-orderedItem-variant" name="productVariantFID"
                                                            class="form-select">
                                                            <option value="<%= item.productVariantFID._id%>" selected>
                                                                <%= item.productVariantFID.productSKU %>
                                                            </option>
                                                            <% ProductVariants.forEach((variant)=> {%>
                                                                <option value="<%= variant._id%>">
                                                                    <%= variant.productSKU %>
                                                                </option>
                                                                <%})%>
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="itemQuantity" class="form-label">Quantity</label>
                                                        <input type="number" class="form-control" name="itemQuantity"
                                                            value="<%= item.itemQuantity %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="itemUnitPrice" class="form-label">Unit
                                                            Price</label>
                                                        <input type="number" step="0.01" class="form-control" name="itemUnitPrice"
                                                            value="<%= item.itemUnitPrice %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="itemTotalPrice" class="form-label">Total
                                                            Price</label>
                                                        <input type="number" step="0.01" class="form-control" name="itemTotalPrice"
                                                            value="<%= item.itemTotalPrice %>" required />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary"
                                                        data-bs-dismiss="modal">
                                                        Cancel
                                                    </button>
                                                    <button type="submit" class="btn btn-primary">Update
                                                        OrderedItem</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Edit OrderedItem Modal-->

                                <!--begin::Delete OrderedItem Modal-->
                                <div class="modal fade" id="modal-delete-orderedItem-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-delete-orderedItem-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="modal-delete-orderedItem-label">Delete OrderedItem
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                    aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="mb-0">
                                                    Are you sure you want to delete this OrderedItem?
                                                    This action cannot be undone.
                                                </p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    Cancel
                                                </button>
                                                <form action="/api/orderedItem/deleteorderedItem/<%= item._id %>" method="post">
                                                    <button type="submit" class="btn btn-danger"
                                                        data-bs-dismiss="modal">
                                                        Delete OrderedItem
                                                    </button>
                                                </form>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Delete OrderedItem Modal-->
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7" class="text-center py-5">
                                                <h5 class="text-muted">
                                                    No OrderedItem Found
                                                </h5>
                                                <p class="text-muted mb-3">
                                                    Start by adding your first OrderedItem.
                                                </p>
                                                <button type="button" class="btn btn-sm btn-primary"
                                                    data-bs-toggle="modal" data-bs-target="#modal-add-orderedItem">
                                                    <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                                                    Add OrderedItem
                                                </button>
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
            <!-- /.table-responsive -->
        </div>
    </div>

    <!--begin::Add OrderedItem Modal-->
    <div class="modal fade" id="modal-add-orderedItem" tabindex="-1" aria-labelledby="modal-add-orderedItem-label"
        aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/api/orderedItem" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modal-add-orderedItem-label">Add new OrderedItem</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <div class="mb-3">
                                <label for="orderFID" class="form-label"> Order Number </label>
                                <select id="new-orderedItem-order" name="orderFID" class="form-select">
                                    <option selected>Select Order</option>
                                    <% Orders.forEach((order)=> {%>
                                        <option value="<%= order._id%>">
                                            <%= order.orderNumber %>
                                        </option>
                                        <%})%>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="mb-3">
                                <label for="productVariantFID" class="form-label"> Product SKU </label>
                                <select id="new-orderedItem-variant" name="productVariantFID" class="form-select">
                                    <option selected>Select Product Variant</option>
                                    <% ProductVariants.forEach((variant)=> {%>
                                        <option value="<%= variant._id%>">
                                            <%= variant.productSKU %>
                                        </option>
                                        <%})%>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="itemQuantity" class="form-label">Quantity</label>
                            <input type="number" class="form-control" name="itemQuantity"
                                placeholder="Enter Quantity" required />
                        </div>
                        <div class="mb-3">
                            <label for="itemUnitPrice" class="form-label">Unit Price</label>
                            <input type="number" step="0.01" class="form-control" name="itemUnitPrice"
                                placeholder="Enter Unit Price" required />
                        </div>
                        <div class="mb-3">
                            <label for="itemTotalPrice" class="form-label">Total Price</label>
                            <input type="number" step="0.01" class="form-control" name="itemTotalPrice"
                                placeholder="Enter Total Price" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary">Create OrderedItem</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!--end::Add OrderedItem Modal-->

    <%- include("../partials/Footer.ejs") %>
