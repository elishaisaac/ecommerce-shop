<%- include("../partials/HeadSection.ejs") %>
    <div class="card mb-4">
        <div class="card-header">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <h3 class="card-title">OrderAddress List</h3>
                </div>
                <div class="col-12 col-md-8">
                    <div class="d-flex flex-wrap justify-content-md-end gap-2">
                        <div class="input-group input-group-sm w-auto">
                            <span class="input-group-text">
                                <i class="bi bi-search" aria-hidden="true"></i>
                            </span>
                            <input type="search" id="user-search" class="form-control" placeholder="Search OrderAddresses"
                                aria-label="Search users" style="width: 180px" />
                        </div>
                                                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#modal-add-orderAddress">
                            <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                            New OrderAddress
                        </button>
                        <!-- data-bs-toggle="modal" -->
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Order Number</th>
                            <th>Address Line 1</th>
                            <th>City</th>
                            <th>State</th>
                            <th>Postal Code</th>
                            <th>Country</th>
                            <th>Phone</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data.length> 0) { %>
                            <% data.forEach((item, index)=> { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <%= index + 1 %>
                                        </div>
                                    </td>
                                    <td>
                                        <%= item.orderFID.orderNumber %>
                                    </td>
                                    <td>
                                        <%= item.addressLine1 %>
                                    </td>
                                    <td>
                                        <%= item.addressCity %>
                                    </td>
                                    <td>
                                        <%= item.addressState %>
                                    </td>
                                    <td>
                                        <%= item.addressPostalCode %>
                                    </td>
                                    <td>
                                        <%= item.addressCountry %>
                                    </td>
                                    <td>
                                        <%= item.addressPhone %>
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modal-edit-orderAddress-<%= item._id %>">
                                                <i class="bi bi-pencil" aria-hidden="true"> </i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal"
                                                data-bs-target="#modal-delete-orderAddress-<%= item._id %>">
                                                <i class="bi bi-trash" aria-hidden="true"> </i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <!--begin::Edit OrderAddress Modal-->
                                <div class="modal fade" id="modal-edit-orderAddress-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-edit-orderAddress-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form action="/api/orderAddress/updateorderAddress/<%= item._id %>" method="post">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="modal-edit-orderAddress-label">Edit
                                                        OrderAddress</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                        aria-label="Close"></button>
                                                </div>

                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label for="orderFID" class="form-label"> Order Number
                                                        </label>
                                                        <select id="new-orderAddress-order" name="orderFID"
                                                            class="form-select">
                                                            <option value="<%= item.orderFID._id%>" selected>
                                                                <%= item.orderFID.orderNumber %>
                                                            </option>
                                                            <% Orders.forEach((order)=> {%>
                                                                <option value="<%= order._id%>">
                                                                    <%= order.orderNumber %>
                                                                </option>
                                                                <%})%>
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="addressLine1" class="form-label">Address
                                                            Line 1</label>
                                                        <input type="text" class="form-control" name="addressLine1"
                                                            value="<%= item.addressLine1 %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="addressLine2" class="form-label">Address
                                                            Line 2</label>
                                                        <input type="text" class="form-control" name="addressLine2"
                                                            value="<%= item.addressLine2 %>" />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="addressCity" class="form-label">City</label>
                                                        <input type="text" class="form-control" name="addressCity"
                                                            value="<%= item.addressCity %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="addressState" class="form-label">State</label>
                                                        <input type="text" class="form-control" name="addressState"
                                                            value="<%= item.addressState %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="addressPostalCode" class="form-label">Postal
                                                            Code</label>
                                                        <input type="text" class="form-control" name="addressPostalCode"
                                                            value="<%= item.addressPostalCode %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="addressCountry" class="form-label">Country</label>
                                                        <input type="text" class="form-control" name="addressCountry"
                                                            value="<%= item.addressCountry %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="addressPhone" class="form-label">Phone</label>
                                                        <input type="text" class="form-control" name="addressPhone"
                                                            value="<%= item.addressPhone %>" required />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary"
                                                        data-bs-dismiss="modal">
                                                        Cancel
                                                    </button>
                                                    <button type="submit" class="btn btn-primary">Update
                                                        OrderAddress</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Edit OrderAddress Modal-->

                                <!--begin::Delete OrderAddress Modal-->
                                <div class="modal fade" id="modal-delete-orderAddress-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-delete-orderAddress-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="modal-delete-orderAddress-label">Delete OrderAddress
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                    aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="mb-0">
                                                    Are you sure you want to delete this OrderAddress?
                                                    This action cannot be undone.
                                                </p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    Cancel
                                                </button>
                                                <form action="/api/orderAddress/deleteorderAddress/<%= item._id %>" method="post">
                                                    <button type="submit" class="btn btn-danger"
                                                        data-bs-dismiss="modal">
                                                        Delete OrderAddress
                                                    </button>
                                                </form>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Delete OrderAddress Modal-->
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="9" class="text-center py-5">
                                                <h5 class="text-muted">
                                                    No OrderAddress Found
                                                </h5>
                                                <p class="text-muted mb-3">
                                                    Start by adding your first OrderAddress.
                                                </p>
                                                <button type="button" class="btn btn-sm btn-primary"
                                                    data-bs-toggle="modal" data-bs-target="#modal-add-orderAddress">
                                                    <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                                                    Add OrderAddress
                                                </button>
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
            <!-- /.table-responsive -->
        </div>
    </div>

    <!--begin::Add OrderAddress Modal-->
    <div class="modal fade" id="modal-add-orderAddress" tabindex="-1" aria-labelledby="modal-add-orderAddress-label"
        aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/api/orderAddress" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modal-add-orderAddress-label">Add new OrderAddress</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <div class="mb-3">
                                <label for="orderFID" class="form-label"> Order Number </label>
                                <select id="new-orderAddress-order" name="orderFID" class="form-select">
                                    <option selected>Select Order</option>
                                    <% Orders.forEach((order)=> {%>
                                        <option value="<%= order._id%>">
                                            <%= order.orderNumber %>
                                        </option>
                                        <%})%>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="addressLine1" class="form-label">Address Line 1</label>
                            <input type="text" class="form-control" name="addressLine1"
                                placeholder="Enter Address Line 1" required />
                        </div>
                        <div class="mb-3">
                            <label for="addressLine2" class="form-label">Address Line 2</label>
                            <input type="text" class="form-control" name="addressLine2"
                                placeholder="Enter Address Line 2" />
                        </div>
                        <div class="mb-3">
                            <label for="addressCity" class="form-label">City</label>
                            <input type="text" class="form-control" name="addressCity"
                                placeholder="Enter City" required />
                        </div>
                        <div class="mb-3">
                            <label for="addressState" class="form-label">State</label>
                            <input type="text" class="form-control" name="addressState"
                                placeholder="Enter State" required />
                        </div>
                        <div class="mb-3">
                            <label for="addressPostalCode" class="form-label">Postal Code</label>
                            <input type="text" class="form-control" name="addressPostalCode"
                                placeholder="Enter Postal Code" required />
                        </div>
                        <div class="mb-3">
                            <label for="addressCountry" class="form-label">Country</label>
                            <input type="text" class="form-control" name="addressCountry"
                                placeholder="Enter Country" required />
                        </div>
                        <div class="mb-3">
                            <label for="addressPhone" class="form-label">Phone</label>
                            <input type="text" class="form-control" name="addressPhone"
                                placeholder="Enter Phone" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary">Create OrderAddress</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!--end::Add OrderAddress Modal-->

    <%- include("../partials/Footer.ejs") %>
