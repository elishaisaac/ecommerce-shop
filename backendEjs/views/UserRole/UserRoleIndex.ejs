<%- include("../partials/HeadSection.ejs") %>
    <div class="card mb-4">
        <div class="card-header">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <h3 class="card-title">UserRole List</h3>
                </div>
                <div class="col-12 col-md-8">
                    <div class="d-flex flex-wrap justify-content-md-end gap-2">
                        <div class="input-group input-group-sm w-auto">
                            <span class="input-group-text">
                                <i class="bi bi-search" aria-hidden="true"></i>
                            </span>
                            <input type="search" id="userRole-search" class="form-control" placeholder="Search UserRoles"
                                aria-label="Search userRoles" style="width: 180px" />
                        </div>

                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#modal-add-userRole">
                            <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                            New UserRole
                        </button>
                        <!-- data-bs-toggle="modal" -->
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>User Email</th>
                            <th>Role Name</th>
                            <th>Role Description</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data.length> 0) { %>
                            <% data.forEach((item, index)=> { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <%= index + 1 %>
                                        </div>
                                    </td>
                                    <td>
                                        <%= item.userFID.userEmail %>
                                    </td>
                                    <td>
                                        <%= item.roleFID.roleName %>
                                    </td>
                                    <td>
                                        <%= item.roleFID.roleDescription %>
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modal-edit-userRole-<%= item._id %>">
                                                <i class="bi bi-pencil" aria-hidden="true"> </i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal"
                                                data-bs-target="#modal-delete-userRole-<%= item._id %>">
                                                <i class="bi bi-trash" aria-hidden="true"> </i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <!--begin::Edit UserRole Modal-->
                                <div class="modal fade" id="modal-edit-userRole-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-edit-userRole-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form action="/api/userRole/updateuserRole/<%= item._id %>" method="post">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="modal-edit-userRole-label">Edit
                                                        UserRole</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                        aria-label="Close"></button>
                                                </div>

                                                <div class="modal-body">
                                                   <div class="mb-3">
                                                        <label for="roleFID" class="form-label"> User Email
                                                        </label>
                                                        <select id="new-userRole-role" name="userFID"
                                                            class="form-select">
                                                            <option value="<%= item.userFID._id%>" selected>
                                                                <%= item.userFID.userEmail %>
                                                            </option>
                                                            <% Users.forEach((user)=> {%>
                                                                <option value="<%= user._id%>">
                                                                    <%= user.userEmail %>
                                                                </option>
                                                                <%})%>
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="roleFID" class="form-label"> Role Name
                                                        </label>
                                                        <select id="new-userRole-role" name="roleFID"
                                                            class="form-select">
                                                            <option value="<%= item.roleFID._id%>" selected>
                                                                <%= item.roleFID.roleName %>
                                                            </option>
                                                            <% Roles.forEach((role)=> {%>
                                                                <option value="<%= role._id%>">
                                                                    <%= role.roleName %>
                                                                </option>
                                                                <%})%>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary"
                                                        data-bs-dismiss="modal">
                                                        Cancel
                                                    </button>
                                                    <button type="submit" class="btn btn-primary">Update
                                                        UserRole</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Edit UserRole Modal-->

                                <!--begin::Delete UserRole Modal-->
                                <div class="modal fade" id="modal-delete-userRole-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-delete-userRole-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="modal-delete-userRole-label">Delete UserRole
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                    aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="mb-0">
                                                    Are you sure you want to delete this UserRole?
                                                    This action cannot be undone.
                                                </p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    Cancel
                                                </button>
                                                <form action="/api/userRole/deleteuserRole/<%= item._id %>" method="post">
                                                    <button type="submit" class="btn btn-danger"
                                                        data-bs-dismiss="modal">
                                                        Delete UserRole
                                                    </button>
                                                </form>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Delete UserRole Modal-->
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="text-center py-5">
                                                <h5 class="text-muted">
                                                    No UserRole Found
                                                </h5>
                                                <p class="text-muted mb-3">
                                                    Start by adding your first UserRole.
                                                </p>
                                                <button type="button" class="btn btn-sm btn-primary"
                                                    data-bs-toggle="modal" data-bs-target="#modal-add-userRole">
                                                    <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                                                    Add UserRole
                                                </button>
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
            <!-- /.table-responsive -->
        </div>
    </div>

    <!--begin::Add UserRole Modal-->
    <div class="modal fade" id="modal-add-userRole" tabindex="-1" aria-labelledby="modal-add-userRole-label"
        aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/api/userRole" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modal-add-userRole-label">Add new UserRole</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <div class="mb-3">
                                <label for="userFID" class="form-label"> User Email </label>
                                <select id="new-userRole-role" name="userFID" class="form-select">
                                    <option selected>Select User Email</option>
                                    <% Users.forEach((user)=> {%>
                                        <option value="<%= user._id%>">
                                            <%= user.userEmail %>
                                        </option>
                                        <%})%>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="mb-3">
                                <label for="roleFID" class="form-label"> Role Name </label>
                                <select id="new-userRole-role" name="roleFID" class="form-select">
                                    <option selected>Select Role</option>
                                    <% Roles.forEach((role)=> {%>
                                        <option value="<%= role._id%>">
                                            <%= role.roleName %>
                                        </option>
                                        <%})%>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary">Create UserRole</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!--end::Add UserRole Modal-->

    <%- include("../partials/Footer.ejs") %>