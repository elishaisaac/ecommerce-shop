<%- include("../partials/HeadSection.ejs") %>
    <div class="card mb-4">
        <div class="card-header">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <h3 class="card-title">Attribute List</h3>
                </div>
                <div class="col-12 col-md-8">
                    <div class="d-flex flex-wrap justify-content-md-end gap-2">
                        <div class="input-group input-group-sm w-auto">
                            <span class="input-group-text">
                                <i class="bi bi-search" aria-hidden="true"></i>
                            </span>
                            <input type="search" id="user-search" class="form-control" placeholder="Search Categories"
                                aria-label="Search users" style="width: 180px" />
                        </div>
                        <select id="user-role-filter" class="form-select form-select-sm w-auto"
                            aria-label="Filter by role">
                            <option value="all" selected>All roles</option>
                            <option value="administrator">Administrator</option>
                            <option value="editor">Editor</option>
                            <option value="author">Author</option>
                            <option value="subscriber">Subscriber</option>
                        </select>
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#modal-add-attribute">
                            <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                            New Attribute
                        </button>
                        <!-- data-bs-toggle="modal" -->
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Attribute Name</th>
                            <th>Attribute Code</th>
                            <th>Attribute Detail</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data.length> 0) { %>
                            <% data.forEach((item, index)=> { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <%= index + 1 %>
                                        </div>
                                    </td>
                                    <td>
                                        <%= item.attributeName %>
                                    </td>
                                    <td>
                                        <%= item.attributeCode %>
                                    </td>
                                    <td>
                                        <%= item.attributeDetail %>
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modal-edit-attribute-<%= item._id %>">
                                                <i class="bi bi-pencil" aria-hidden="true"> </i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal"
                                                data-bs-target="#modal-delete-attribute-<%= item._id %>">
                                                <i class="bi bi-trash" aria-hidden="true"> </i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <!--begin::Edit Attribute Modal-->
                                <div class="modal fade" id="modal-edit-attribute-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-edit-attribute-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form action="/api/attribute/updateAttribute/<%= item._id %>" method="post">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="modal-edit-attribute-label">Edit
                                                        Attribute</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                        aria-label="Close"></button>
                                                </div>

                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label for="attributeName" class="form-label">Attribute
                                                            Name</label>
                                                        <input type="text" class="form-control" name="attributeName"
                                                            value="<%= item.attributeName %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="attributeCode" class="form-label">Attribute
                                                            Code</label>
                                                        <input type="text" class="form-control" name="attributeCode"
                                                            value="<%= item.attributeCode %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="attributeDetail" class="form-label">Attribute
                                                            Detail</label>
                                                        <input type="text" class="form-control" name="attributeDetail"
                                                            value="<%= item.attributeDetail %>" required />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary"
                                                        data-bs-dismiss="modal">
                                                        Cancel
                                                    </button>
                                                    <button type="submit" class="btn btn-primary">Update
                                                        Attribute</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Edit Attribute Modal-->

                                <!--begin::Delete Attribute Modal-->
                                <div class="modal fade" id="modal-delete-attribute-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-delete-attribute-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="modal-delete-attribute-label">Delete Attribute
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                    aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="mb-0">
                                                    Are you sure you want to delete this Attribute?
                                                    This action cannot be undone.
                                                </p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    Cancel
                                                </button>
                                                <form action="/api/attribute/deleteAttribute/<%= item._id %>"
                                                    method="post">
                                                    <button type="submit" class="btn btn-danger"
                                                        data-bs-dismiss="modal">
                                                        Delete Attribute
                                                    </button>
                                                </form>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Delete Attribute Modal-->
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="text-center py-5">
                                                <h5 class="text-muted">
                                                    No Attribute Found
                                                </h5>
                                                <p class="text-muted mb-3">
                                                    Start by adding your first Attribute.
                                                </p>
                                                <button type="button" class="btn btn-sm btn-primary"
                                                    data-bs-toggle="modal" data-bs-target="#modal-add-attribute">
                                                    <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                                                    Add Attribute
                                                </button>
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
            <!-- /.table-responsive -->
        </div>
    </div>

    <!--begin::Add User Modal-->
    <div class="modal fade" id="modal-add-attribute" tabindex="-1" aria-labelledby="modal-add-attribute-label"
        aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/api/attribute" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modal-add-attribute-label">Add new Attribute</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="attributeName" class="form-label">Attribute Name</label>
                            <input type="text" class="form-control" name="attributeName"
                                placeholder="Enter Attribute Name" required />
                        </div>
                        <div class="mb-3">
                            <label for="attributeCode" class="form-label">Attribute Code</label>
                            <input type="text" class="form-control" name="attributeCode"
                                placeholder="Enter Attribute Code" required />
                        </div>
                        <div class="mb-3">
                            <label for="attributeDetail" class="form-label">Attribute Detail</label>
                            <input type="text" class="form-control" name="attributeDetail"
                                placeholder="Enter Attribute Detail" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary">Create Attribute</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!--end::Add User Modal-->

    <%- include("../partials/Footer.ejs") %>

