<%- include("../partials/HeadSection.ejs") %>
    <div class="card mb-4">
        <div class="card-header">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <h3 class="card-title">RolePermission List</h3>
                </div>
                <div class="col-12 col-md-8">
                    <div class="d-flex flex-wrap justify-content-md-end gap-2">
                        <div class="input-group input-group-sm w-auto">
                            <span class="input-group-text">
                                <i class="bi bi-search" aria-hidden="true"></i>
                            </span>
                            <input type="search" id="rolePermission-search" class="form-control" placeholder="Search RolePermissions"
                                aria-label="Search rolePermissions" style="width: 180px" />
                        </div>
                        <select id="rolePermission-role-filter" class="form-select form-select-sm w-auto"
                            aria-label="Filter by role">
                            <option value="all" selected>All roles</option>
                            <option value="administrator">Administrator</option>
                            <option value="editor">Editor</option>
                            <option value="author">Author</option>
                            <option value="subscriber">Subscriber</option>
                        </select>
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#modal-add-rolePermission">
                            <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                            New RolePermission
                        </button>
                        <!-- data-bs-toggle="modal" -->
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Role Name</th>
                            <th>Permission Resourse</th>
                            <th>Permission Action</th>
                            <th>Permission Description</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data.length> 0) { %>
                            <% data.forEach((item, index)=> { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <%= index + 1 %>
                                        </div>
                                    </td>
                                    <td>
                                        <%= item.roleFID.roleName %>
                                    </td>
                                    <td>
                                        <%= item.permissionFID.permissionAction %>
                                    </td>
                                    <td>
                                        <%= item.permissionFID.permissionResourse %>
                                    </td>
                                    <td>
                                        <%= item.permissionFID.permissionDescription %>
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modal-edit-rolePermission-<%= item._id %>">
                                                <i class="bi bi-pencil" aria-hidden="true"> </i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal"
                                                data-bs-target="#modal-delete-rolePermission-<%= item._id %>">
                                                <i class="bi bi-trash" aria-hidden="true"> </i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <!--begin::Edit RolePermission Modal-->
                                <div class="modal fade" id="modal-edit-rolePermission-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-edit-rolePermission-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form action="/api/rolePermission/updateRolePermission/<%= item._id %>" method="post">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="modal-edit-rolePermission-label">Edit
                                                        RolePermission</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                        aria-label="Close"></button>
                                                </div>

                                                <div class="modal-body">
                                                   <div class="mb-3">
                                                        <label for="roleFID" class="form-label"> Role Name
                                                        </label>
                                                        <select id="new-rolePermission-role" name="roleFID"
                                                            class="form-select">
                                                            <option value="<%= item.roleFID._id%>" selected>
                                                                <%= item.roleFID.roleName %>
                                                            </option>
                                                            <% Roles.forEach((role)=> {%>
                                                                <option value="<%= role._id%>">
                                                                    <%= role.roleName %>
                                                                </option>
                                                                <%})%>
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="permissionFID" class="form-label"> Permission Action
                                                        </label>
                                                        <select id="new-rolePermission-role" name="permissionFID"
                                                            class="form-select">
                                                            <option value="<%= item.permissionFID._id%>" selected>
                                                                <%= item.permissionFID.permissionAction %>
                                                            </option>
                                                            <% Permissions.forEach((permission)=> {%>
                                                                <option value="<%= permission._id%>">
                                                                    <%= permission.permissionAction %>
                                                                </option>
                                                                <%})%>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary"
                                                        data-bs-dismiss="modal">
                                                        Cancel
                                                    </button>
                                                    <button type="submit" class="btn btn-primary">Update
                                                        RolePermission</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Edit RolePermission Modal-->

                                <!--begin::Delete RolePermission Modal-->
                                <div class="modal fade" id="modal-delete-rolePermission-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-delete-rolePermission-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="modal-delete-rolePermission-label">Delete RolePermission
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                    aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="mb-0">
                                                    Are you sure you want to delete this RolePermission?
                                                    This action cannot be undone.
                                                </p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    Cancel
                                                </button>
                                                <form action="/api/rolePermission/deleteRolePermission/<%= item._id %>" method="post">
                                                    <button type="submit" class="btn btn-danger"
                                                        data-bs-dismiss="modal">
                                                        Delete RolePermission
                                                    </button>
                                                </form>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Delete RolePermission Modal-->
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="text-center py-5">
                                                <h5 class="text-muted">
                                                    No RolePermission Found
                                                </h5>
                                                <p class="text-muted mb-3">
                                                    Start by adding your first RolePermission.
                                                </p>
                                                <button type="button" class="btn btn-sm btn-primary"
                                                    data-bs-toggle="modal" data-bs-target="#modal-add-rolePermission">
                                                    <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                                                    Add RolePermission
                                                </button>
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
            <!-- /.table-responsive -->
        </div>
    </div>

    <!--begin::Add RolePermission Modal-->
    <div class="modal fade" id="modal-add-rolePermission" tabindex="-1" aria-labelledby="modal-add-rolePermission-label"
        aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/api/rolePermission" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modal-add-rolePermission-label">Add new RolePermission</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <div class="mb-3">
                                <label for="roleFID" class="form-label"> Role Name </label>
                                <select id="new-rolePermission-role" name="roleFID" class="form-select">
                                    <option selected>Select Role</option>
                                    <% Roles.forEach((role)=> {%>
                                        <option value="<%= role._id%>">
                                            <%= role.roleName %>
                                        </option>
                                        <%})%>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="mb-3">
                                <label for="permissionFID" class="form-label"> Permission Action </label>
                                <select id="new-rolePermission-role" name="permissionFID" class="form-select">
                                    <option selected>Select Permission Action</option>
                                    <% Permissions.forEach((permission)=> {%>
                                        <option value="<%= permission._id%>">
                                            <%= permission.permissionAction %>
                                        </option>
                                        <%})%>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary">Create RolePermission</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!--end::Add RolePermission Modal-->

    <%- include("../partials/Footer.ejs") %>