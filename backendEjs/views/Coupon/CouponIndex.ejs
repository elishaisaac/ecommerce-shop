<%- include("../partials/HeadSection.ejs") %>
    <div class="card mb-4">
        <div class="card-header">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <h3 class="card-title">Coupon List</h3>
                </div>
                <div class="col-12 col-md-8">
                    <div class="d-flex flex-wrap justify-content-md-end gap-2">
                        <div class="input-group input-group-sm w-auto">
                            <span class="input-group-text">
                                <i class="bi bi-search" aria-hidden="true"></i>
                            </span>
                            <input type="search" id="user-search" class="form-control" placeholder="Search Coupons"
                                aria-label="Search users" style="width: 180px" />
                        </div>
                                                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#modal-add-coupon">
                            <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                            New Coupon
                        </button>
                        <!-- data-bs-toggle="modal" -->
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Coupon Code</th>
                            <th>Coupon Type</th>
                            <th>Coupon Value</th>
                            <th>Expiry Date</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data.length> 0) { %>
                            <% data.forEach((item, index)=> { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <%= index + 1 %>
                                        </div>
                                    </td>
                                    <td>
                                        <%= item.couponCode %>
                                    </td>
                                    <td>
                                        <%= item.couponType %>
                                    </td>
                                    <td>
                                        <%= item.couponValue %>
                                    </td>
                                    <td>
                                        <%= item.couponExpiryDate %>
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modal-edit-coupon-<%= item._id %>">
                                                <i class="bi bi-pencil" aria-hidden="true"> </i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal"
                                                data-bs-target="#modal-delete-coupon-<%= item._id %>">
                                                <i class="bi bi-trash" aria-hidden="true"> </i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <!--begin::Edit Coupon Modal-->
                                <div class="modal fade" id="modal-edit-coupon-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-edit-coupon-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form action="/api/coupon/updatecoupon/<%= item._id %>" method="post">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="modal-edit-coupon-label">Edit
                                                        Coupon</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                        aria-label="Close"></button>
                                                </div>

                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label for="couponCode" class="form-label">Coupon
                                                            Code</label>
                                                        <input type="text" class="form-control" name="couponCode"
                                                            value="<%= item.couponCode %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="couponType" class="form-label">Coupon
                                                            Type</label>
                                                        <select id="new-coupon-type" name="couponType"
                                                            class="form-select">
                                                            <% ["Percentage", "Fixed"].forEach((type)=> { %>
                                                                <option value="<%= type %>" <%= item.couponType===type ? "selected" : "" %>>
                                                                    <%= type %>
                                                                </option>
                                                                <% }) %>
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="couponValue" class="form-label">Coupon
                                                            Value</label>
                                                        <input type="number" step="0.01" class="form-control" name="couponValue"
                                                            value="<%= item.couponValue %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="couponExpiryDate" class="form-label">Expiry
                                                            Date</label>
                                                        <input type="date" class="form-control" name="couponExpiryDate"
                                                            value="<%= item.couponExpiryDate %>" required />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary"
                                                        data-bs-dismiss="modal">
                                                        Cancel
                                                    </button>
                                                    <button type="submit" class="btn btn-primary">Update
                                                        Coupon</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Edit Coupon Modal-->

                                <!--begin::Delete Coupon Modal-->
                                <div class="modal fade" id="modal-delete-coupon-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-delete-coupon-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="modal-delete-coupon-label">Delete Coupon
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                    aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="mb-0">
                                                    Are you sure you want to delete this Coupon?
                                                    This action cannot be undone.
                                                </p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    Cancel
                                                </button>
                                                <form action="/api/coupon/deletecoupon/<%= item._id %>" method="post">
                                                    <button type="submit" class="btn btn-danger"
                                                        data-bs-dismiss="modal">
                                                        Delete Coupon
                                                    </button>
                                                </form>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Delete Coupon Modal-->
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="text-center py-5">
                                                <h5 class="text-muted">
                                                    No Coupon Found
                                                </h5>
                                                <p class="text-muted mb-3">
                                                    Start by adding your first Coupon.
                                                </p>
                                                <button type="button" class="btn btn-sm btn-primary"
                                                    data-bs-toggle="modal" data-bs-target="#modal-add-coupon">
                                                    <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                                                    Add Coupon
                                                </button>
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
            <!-- /.table-responsive -->
        </div>
    </div>

    <!--begin::Add Coupon Modal-->
    <div class="modal fade" id="modal-add-coupon" tabindex="-1" aria-labelledby="modal-add-coupon-label"
        aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/api/coupon" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modal-add-coupon-label">Add new Coupon</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="couponCode" class="form-label">Coupon Code</label>
                            <input type="text" class="form-control" name="couponCode"
                                placeholder="Enter Coupon Code" required />
                        </div>
                        <div class="mb-3">
                            <label for="couponType" class="form-label">Coupon Type</label>
                            <select id="new-coupon-type" name="couponType" class="form-select">
                                <% ["Percentage", "Fixed"].forEach((type)=> { %>
                                    <option value="<%= type %>" <%= type==="Percentage" ? "selected" : "" %>>
                                        <%= type %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="couponValue" class="form-label">Coupon Value</label>
                            <input type="number" step="0.01" class="form-control" name="couponValue"
                                placeholder="Enter Coupon Value" required />
                        </div>
                        <div class="mb-3">
                            <label for="couponExpiryDate" class="form-label">Expiry Date</label>
                            <input type="date" class="form-control" name="couponExpiryDate" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary">Create Coupon</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!--end::Add Coupon Modal-->

    <%- include("../partials/Footer.ejs") %>
