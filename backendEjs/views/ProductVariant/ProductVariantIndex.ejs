<%- include("../partials/HeadSection.ejs") %>
    <div class="card mb-4">
        <div class="card-header">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <h3 class="card-title">Product Variants List</h3>
                </div>
                <div class="col-12 col-md-8">
                    <div class="d-flex flex-wrap justify-content-md-end gap-2">
                        <div class="input-group input-group-sm w-auto">
                            <span class="input-group-text">
                                <i class="bi bi-search" aria-hidden="true"></i>
                            </span>
                            <input type="search" id="user-search" class="form-control" placeholder="Search Product Variants"
                                aria-label="Search users" style="width: 180px" />
                        </div>
                                                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#modal-add-productVariant">
                            <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                            New Product Variants
                        </button>
                        <!-- data-bs-toggle="modal" -->
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Product Name</th>
                            <th>Product SKU</th>
                            <th>Product Actual Price</th>
                            <th>Product Discount Percent</th>
                            <th>Product Sale Price</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data.length> 0) { %>
                            <% data.forEach((item, index)=> { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <%= index + 1 %>
                                        </div>
                                    </td>
                                    <td>
                                        <%= item.productFID.productName %>
                                    </td>
                                    <td>
                                        <%= item.productSKU %>
                                    </td>
                                    <td>
                                        <%= item.productActualPrice %>
                                    </td>
                                    <td>
                                        <%= item.productDiscountPercent %>
                                    </td>
                                    <td>
                                        <%= item.productSalePrice %>
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modal-edit-productVariant-<%= item._id %>">
                                                <i class="bi bi-pencil" aria-hidden="true"> </i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal"
                                                data-bs-target="#modal-delete-productVariant-<%= item._id %>">
                                                <i class="bi bi-trash" aria-hidden="true"> </i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <!--begin::Edit Product Variant Modal-->
                                <div class="modal fade" id="modal-edit-productVariant-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-edit-productVariant-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form action="/api/productVariant/updateproductVariant/<%= item._id %>" method="post">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="modal-edit-productVariant-label">Edit
                                                        Product Variant</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                        aria-label="Close"></button>
                                                </div>

                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label for="productFID" class="form-label"> Product Name
                                                        </label>
                                                        <select id="new-user-role" name="productFID"
                                                            class="form-select">
                                                            <option value="<%= item.productFID._id%>" selected>
                                                                <%= item.productFID.productName %>
                                                            </option>
                                                            <% Products.forEach((product)=> {%>
                                                                <option value="<%= product._id%>">
                                                                    <%= product.productName%>
                                                                </option>
                                                                <%})%>
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="productSKU" class="form-label">Product SKU</label>
                                                        <input type="text" class="form-control" name="productSKU"
                                                            value="<%= item.productSKU %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="productActualPrice" class="form-label">Product Actual Price</label>
                                                        <input type="text" class="form-control" name="productActualPrice"
                                                            value="<%= item.productActualPrice %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="productDiscountPercent" class="form-label">Product Discount Percentage</label>
                                                        <input type="text" class="form-control" name="productDiscountPercent"
                                                            value="<%= item.productDiscountPercent %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="productSalePrice" class="form-label">Product Sale Price</label>
                                                        <input type="text" class="form-control" name="productSalePrice"
                                                            value="<%= item.productSalePrice %>" required />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary"
                                                        data-bs-dismiss="modal">
                                                        Cancel
                                                    </button>
                                                    <button type="submit" class="btn btn-primary">Update
                                                        Product Variant</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Edit Product Modal-->

                                <!--begin::Delete Product Modal-->
                                <div class="modal fade" id="modal-delete-productVariant-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-delete-productVariant-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="modal-delete-productVariant-label">Delete Product
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                    aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="mb-0">
                                                    Are you sure you want to delete this Product?
                                                    This action cannot be undone.
                                                </p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    Cancel
                                                </button>
                                                <form action="/api/productVariant/deleteproductVariant/<%= item._id %>" method="post">
                                                    <button type="submit" class="btn btn-danger"
                                                        data-bs-dismiss="modal">
                                                        Delete Product
                                                    </button>
                                                </form>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Delete Product Modal-->
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="text-center py-5">
                                                <h5 class="text-muted">
                                                    No Product Variant Found
                                                </h5>
                                                <p class="text-muted mb-3">
                                                    Start by adding your first Product Variant.
                                                </p>
                                                <button type="button" class="btn btn-sm btn-primary"
                                                    data-bs-toggle="modal" data-bs-target="#modal-add-productVariant">
                                                    <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                                                    Add Product Variant
                                                </button>
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
            <!-- /.table-responsive -->
        </div>
    </div>

    <!--begin::Add User Modal-->
    <div class="modal fade" id="modal-add-productVariant" tabindex="-1" aria-labelledby="modal-add-productVariant-label"
        aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/api/productVariant" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modal-add-product-label">Add new Product Variant</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="productFID" class="form-label"> Product Name </label>
                            <select id="new-user-role" name="productFID" class="form-select">
                                <option selected>Select Product Name</option>
                                <% Products.forEach((product)=> {%>
                                    <option value="<%= product._id%>">
                                        <%= product.productName %>
                                    </option>
                                    <%})%>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="productSKU" class="form-label">Product SKU</label>
                            <input type="text" class="form-control" name="productSKU"
                                placeholder="Enter product SKU" required />
                        </div>
                        <div class="mb-3">
                            <label for="productActualPrice" class="form-label">Product Actual Price</label>
                            <input type="text" class="form-control" name="productActualPrice"
                                placeholder="Enter product Actual Price" required />
                        </div>
                        <div class="mb-3">
                            <label for="productDiscountPercent" class="form-label">Product Discount Percentage</label>
                            <input type="text" class="form-control" name="productDiscountPercent"
                                placeholder="Enter product Discount Percentage" required />
                        </div>
                        <div class="mb-3">
                            <label for="productSalePrice" class="form-label">Product Sale Price</label>
                            <input type="text" class="form-control" name="productSalePrice"
                                placeholder="Enter product Sale Price" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary">Create Product Variant</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!--end::Add User Modal-->

    <%- include("../partials/Footer.ejs") %>