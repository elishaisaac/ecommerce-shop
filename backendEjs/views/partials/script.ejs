<script>
    (function () {
        const refresh = (form) => {
            if (!form) return
            const actual = form.elements["productActualPrice"]
            const discount = form.elements["productDiscountPercent"]
            const preview = Array.from(form.elements).find(
                (el) => el.hasAttribute("data-sale-preview")
            )
            if (!actual || !discount || !preview) return

            const a = Number(actual.value)
            const d = Number(discount.value || 0)
            preview.value =
                a > 0 && d >= 0 && d <= 100
                    ? "Rs. " + Math.round((a * (100 - d)) / 100).toLocaleString()
                    : ""
        }

        document.addEventListener("input", (e) => {
            if (e.target.form) refresh(e.target.form)
        })

        document.addEventListener("shown.bs.modal", (e) => {
            const preview = e.target.querySelector("[data-sale-preview]")
            if (preview) refresh(preview.form)
        })

        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll("[data-sale-preview]").forEach((preview) => {
                refresh(preview.form)
            })
        })
    })()
</script>
<!--end::Script-->