<%- include("../partials/HeadSection.ejs") %>
    <div class="card mb-4">
        <div class="card-header">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <h3 class="card-title">Brand List</h3>
                </div>
                <div class="col-12 col-md-8">
                    <div class="d-flex flex-wrap justify-content-md-end gap-2">
                        <div class="input-group input-group-sm w-auto">
                            <span class="input-group-text">
                                <i class="bi bi-search" aria-hidden="true"></i>
                            </span>
                            <input type="search" id="user-search" class="form-control" placeholder="Search Brands"
                                aria-label="Search users" style="width: 180px" />
                        </div>
                                                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#modal-add-brand">
                            <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                            New Brand
                        </button>
                        <!-- data-bs-toggle="modal" -->
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Brand Name</th>
                            <th>Brand Code</th>
                            <th>Brand Detail</th>
                            <th>Brand Logo</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data.length> 0) { %>
                            <% data.forEach((item, index)=> { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <%= index + 1 %>
                                        </div>
                                    </td>
                                    <td>
                                        <%= item.brandName %>
                                    </td>
                                    <td>
                                        <%= item.brandCode %>
                                    </td>
                                    <td>
                                        <%= item.brandDetail %>
                                    </td>
                                    <td>
                                        <%= item.brandLogo %>
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modal-edit-brand-<%= item._id %>">
                                                <i class="bi bi-pencil" aria-hidden="true"> </i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal"
                                                data-bs-target="#modal-delete-brand-<%= item._id %>">
                                                <i class="bi bi-trash" aria-hidden="true"> </i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <!--begin::Edit Brand Modal-->
                                <div class="modal fade" id="modal-edit-brand-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-edit-brand-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form action="/api/brand/updatebrand/<%= item._id %>" method="post">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="modal-edit-brand-label">Edit
                                                        Brand</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                        aria-label="Close"></button>
                                                </div>

                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label for="brandName" class="form-label">Brand
                                                            Name</label>
                                                        <input type="text" class="form-control" name="brandName"
                                                            value="<%= item.brandName %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="brandCode" class="form-label">Brand
                                                            Code</label>
                                                        <input type="text" class="form-control" name="brandCode"
                                                            value="<%= item.brandCode %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="brandDetail" class="form-label">Brand
                                                            Detail</label>
                                                        <input type="text" class="form-control" name="brandDetail"
                                                            value="<%= item.brandDetail %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="brandLogo" class="form-label">Brand
                                                            Logo</label>
                                                        <input type="text" class="form-control" name="brandLogo"
                                                            value="<%= item.brandLogo %>" required />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary"
                                                        data-bs-dismiss="modal">
                                                        Cancel
                                                    </button>
                                                    <button type="submit" class="btn btn-primary">Update
                                                        Brand</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Edit Brand Modal-->

                                <!--begin::Delete Brand Modal-->
                                <div class="modal fade" id="modal-delete-brand-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-delete-brand-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="modal-delete-brand-label">Delete Brand
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                    aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="mb-0">
                                                    Are you sure you want to delete this Brand?
                                                    This action cannot be undone.
                                                </p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    Cancel
                                                </button>
                                                <form action="/api/brand/deletebrand/<%= item._id %>"
                                                    method="post">
                                                    <button type="submit" class="btn btn-danger"
                                                        data-bs-dismiss="modal">
                                                        Delete Brand
                                                    </button>
                                                </form>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Delete Brand Modal-->
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="text-center py-5">
                                                <h5 class="text-muted">
                                                    No Brand Found
                                                </h5>
                                                <p class="text-muted mb-3">
                                                    Start by adding your first Brand.
                                                </p>
                                                <button type="button" class="btn btn-sm btn-primary"
                                                    data-bs-toggle="modal" data-bs-target="#modal-add-brand">
                                                    <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                                                    Add Brand
                                                </button>
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
            <!-- /.table-responsive -->
        </div>
    </div>

    <!--begin::Add User Modal-->
    <div class="modal fade" id="modal-add-brand" tabindex="-1" aria-labelledby="modal-add-brand-label"
        aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/api/brand" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modal-add-brand-label">Add new Brand</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="brandName" class="form-label">Brand Name</label>
                            <input type="text" class="form-control" name="brandName"
                                placeholder="Enter Brand Name" required />
                        </div>
                        <div class="mb-3">
                            <label for="brandCode" class="form-label">Brand Code</label>
                            <input type="text" class="form-control" name="brandCode"
                                placeholder="Enter brand Code" required />
                        </div>
                        <div class="mb-3">
                            <label for="brandDetail" class="form-label">Brand Detail</label>
                            <input type="text" class="form-control" name="brandDetail"
                                placeholder="Enter Brand Detail" required />
                        </div>
                        <div class="mb-3">
                            <label for="brandLogo" class="form-label">Brand Logo</label>
                            <input type="text" class="form-control" name="brandLogo"
                                placeholder="Enter Brand Logo" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary">Create Brand</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!--end::Add User Modal-->

    <%- include("../partials/Footer.ejs") %>

