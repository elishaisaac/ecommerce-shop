<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Attribute Vaue</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-6">

                <!-- Form Card -->
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h3 class="fw-bold mb-1">
                            Edit Attribute Value
                        </h3>
                        <p class="text-muted mb-4">
                            Enter the Attribute Value information below.
                        </p>
                        <form action="/api/attributeValue/updateAttributeValue/<%= attributeValue._id %>" method="post">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Attribute ID
                                </label>
                                <input type="text" class="form-control" name="attributeFID" required value="<%= attributeValue.attributeFID %>">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Attribute Value
                                </label>
                                <input type="text" class="form-control" name="attributeValue" required value="<%= attributeValue.attributeValue %>">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Attribute Value Code
                                </label>
                                <input type="text" class="form-control" name="attributeValueCode" required value="<%= attributeValue.attributeValueCode %>">
                            </div>


                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-success">
                                    Save
                                </button>
                                <a href="/api/attributeValue" class="btn btn-secondary">
                                    Cancel
                                </a>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>

</body>

</html>