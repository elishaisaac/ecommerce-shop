<%- include("../partials/HeadSection.ejs") %>
    <div class="card mb-4">
        <div class="card-header">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <h3 class="card-title">Attribute Value List</h3>
                </div>
                <div class="col-12 col-md-8">
                    <div class="d-flex flex-wrap justify-content-md-end gap-2">
                        <div class="input-group input-group-sm w-auto">
                            <span class="input-group-text">
                                <i class="bi bi-search" aria-hidden="true"></i>
                            </span>
                            <input type="search" id="user-search" class="form-control" placeholder="Search Attributes"
                                aria-label="Search users" style="width: 180px" />
                        </div>
                                                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#modal-add-attributeValue">
                            <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                            New Attribute Value
                        </button>
                        <!-- data-bs-toggle="modal" -->
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Attribute Name</th>
                            <th>Attribute Value</th>
                            <th>Attribute Value Code</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data.length> 0) { %>
                            <% data.forEach((item, index)=> { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <%= index + 1 %>
                                        </div>
                                    </td>
                                    <td>
                                        <%= item.attributeFID.attributeName %>
                                    </td>
                                    <td>
                                        <%= item.attributeValue %>
                                    </td>
                                    <td>
                                        <%= item.attributeValueCode %>
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modal-edit-attributeValue-<%= item._id %>">
                                                <i class="bi bi-pencil" aria-hidden="true"> </i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal"
                                                data-bs-target="#modal-delete-attributeValue-<%= item._id %>">
                                                <i class="bi bi-trash" aria-hidden="true"> </i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <!--begin::Edit Attribute Value Modal-->
                                <div class="modal fade" id="modal-edit-attributeValue-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-edit-attributeValue-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form action="/api/attributeValue/updateAttributeValue/<%= item._id %>"
                                                method="post">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="modal-edit-attributeValue-label">Edit
                                                        Attribute Value</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                        aria-label="Close"></button>
                                                </div>

                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label for="attributeFID" class="form-label"> Attribute Name
                                                        </label>
                                                        <select id="new-user-role" name="attributeFID"
                                                            class="form-select">
                                                            <option value="<%= item.attributeFID._id%>" selected>
                                                                <%= item.attributeFID.attributeName %>
                                                            </option>
                                                            <% Attributes.forEach((attribute)=> {%>
                                                                <option value="<%= attribute._id%>">
                                                                    <%= attribute.attributeName %>
                                                                </option>
                                                                <%})%>
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="attributeValue" class="form-label">Attribute
                                                            Value
                                                            Code</label>
                                                        <input type="text" class="form-control"
                                                            name="attributeValue"
                                                            value="<%= item.attributeValue %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="attributeValueCode" class="form-label">Attribute
                                                            Value Code
                                                            Detail</label>
                                                        <input type="text" class="form-control"
                                                            name="attributeValueCode"
                                                            value="<%= item.attributeValueCode %>" required />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary"
                                                        data-bs-dismiss="modal">
                                                        Cancel
                                                    </button>
                                                    <button type="submit" class="btn btn-primary">Update
                                                        Attribute Value</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Edit Attribute Value Modal-->

                                <!--begin::Delete Attribute Value Modal-->
                                <div class="modal fade" id="modal-delete-attributeValue-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-delete-attributeValue-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="modal-delete-attributeValue-label">Delete
                                                    Attribute Value
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                    aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="mb-0">
                                                    Are you sure you want to delete this Attribute Value?
                                                    This action cannot be undone.
                                                </p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    Cancel
                                                </button>
                                                <form action="/api/attributeValue/deleteAttributeValue/<%= item._id %>"
                                                    method="post">
                                                    <button type="submit" class="btn btn-danger"
                                                        data-bs-dismiss="modal">
                                                        Delete Attribute Value
                                                    </button>
                                                </form>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Delete Attribute Value Modal-->
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="text-center py-5">
                                                <h5 class="text-muted">
                                                    No Attribute Value Found
                                                </h5>
                                                <p class="text-muted mb-3">
                                                    Start by adding your first Attribute Value.
                                                </p>
                                                <button type="button" class="btn btn-sm btn-primary"
                                                    data-bs-toggle="modal" data-bs-target="#modal-add-attributeValue">
                                                    <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                                                    Add Attribute Value
                                                </button>
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
            <!-- /.table-responsive -->
        </div>
    </div>

    <!--begin::Add User Modal-->
    <div class="modal fade" id="modal-add-attributeValue" tabindex="-1" aria-labelledby="modal-add-attributeValue-label"
        aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/api/attributeValue" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modal-add-attributeValue-label">Add new Attribute Value</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <div class="mb-3">
                                <label for="attributeFID" class="form-label"> Attribute Name </label>
                                <select id="new-user-role" name="attributeFID" class="form-select">
                                    <option selected>Select Attribute</option>
                                    <% Attributes.forEach((attribute)=> {%>
                                        <option value="<%= attribute._id%>">
                                            <%= attribute.attributeName%>
                                        </option>
                                        <%})%>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="attributeValue" class="form-label">Attribute Value</label>
                            <input type="text" class="form-control" name="attributeValue"
                                placeholder="Enter Attribute Value Name" required />
                        </div>
                        <div class="mb-3">
                            <label for="attributeValueCode" class="form-label">Attribute Value Code</label>
                            <input type="text" class="form-control" name="attributeValueCode"
                                placeholder="Enter Attribute Value Code" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary">Create Attribute Value</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!--end::Add User Modal-->

    <%- include("../partials/Footer.ejs") %>