<%- include("../partials/HeadSection.ejs") %>
    <div class="card mb-4">
        <div class="card-header">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <h3 class="card-title">Category List</h3>
                </div>
                <div class="col-12 col-md-8">
                    <div class="d-flex flex-wrap justify-content-md-end gap-2">
                        <div class="input-group input-group-sm w-auto">
                            <span class="input-group-text">
                                <i class="bi bi-search" aria-hidden="true"></i>
                            </span>
                            <input type="search" id="user-search" class="form-control" placeholder="Search Categories"
                                aria-label="Search users" style="width: 180px" />
                        </div>
                        <select id="user-role-filter" class="form-select form-select-sm w-auto"
                            aria-label="Filter by role">
                            <option value="all" selected>All roles</option>
                            <option value="administrator">Administrator</option>
                            <option value="editor">Editor</option>
                            <option value="author">Author</option>
                            <option value="subscriber">Subscriber</option>
                        </select>
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#modal-add-category">
                            <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                            New Category
                        </button>
                        <!-- data-bs-toggle="modal" -->
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Category Name</th>
                            <th>Category Code</th>
                            <th>Category Detail</th>
                            <th>Category Image</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data.length> 0) { %>
                            <% data.forEach((item, index)=> { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <%= index + 1 %>
                                        </div>
                                    </td>
                                    <td>
                                        <%= item.categoryName %>
                                    </td>
                                    <td>
                                        <%= item.categoryCode %>
                                    </td>
                                    <td>
                                        <%= item.categoryDetail %>
                                    </td>
                                    <td>
                                        <%= item.categoryImage %>
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modal-edit-category-<%= item._id %>">
                                                <i class="bi bi-pencil" aria-hidden="true"> </i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal"
                                                data-bs-target="#modal-delete-category-<%= item._id %>">
                                                <i class="bi bi-trash" aria-hidden="true"> </i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <!--begin::Edit Category Modal-->
                                <div class="modal fade" id="modal-edit-category-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-edit-category-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form action="/api/category/updateCategory/<%= item._id %>" method="post">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="modal-edit-category-label">Edit
                                                        Category</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                        aria-label="Close"></button>
                                                </div>

                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label for="categoryName" class="form-label">Category
                                                            Name</label>
                                                        <input type="text" class="form-control" name="categoryName"
                                                            value="<%= item.categoryName %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="categoryCode" class="form-label">Category
                                                            Code</label>
                                                        <input type="text" class="form-control" name="categoryCode"
                                                            value="<%= item.categoryCode %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="categoryDetail" class="form-label">Category
                                                            Detail</label>
                                                        <input type="text" class="form-control" name="categoryDetail"
                                                            value="<%= item.categoryDetail %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="categoryImage" class="form-label">Category
                                                            Image</label>
                                                        <input type="text" class="form-control" name="categoryImage"
                                                            value="<%= item.categoryImage %>" required />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary"
                                                        data-bs-dismiss="modal">
                                                        Cancel
                                                    </button>
                                                    <button type="submit" class="btn btn-primary">Update
                                                        Category</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Edit Category Modal-->

                                <!--begin::Delete Category Modal-->
                                <div class="modal fade" id="modal-delete-category-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-delete-category-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="modal-delete-category-label">Delete Category
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                    aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="mb-0">
                                                    Are you sure you want to delete this Category?
                                                    This action cannot be undone.
                                                </p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    Cancel
                                                </button>
                                                <form action="/api/category/deleteCategory/<%= item._id %>"
                                                    method="post">
                                                    <button type="submit" class="btn btn-danger"
                                                        data-bs-dismiss="modal">
                                                        Delete Category
                                                    </button>
                                                </form>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Delete Category Modal-->
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="text-center py-5">
                                                <h5 class="text-muted">
                                                    No Category Found
                                                </h5>
                                                <p class="text-muted mb-3">
                                                    Start by adding your first Category.
                                                </p>
                                                <button type="button" class="btn btn-sm btn-primary"
                                                    data-bs-toggle="modal" data-bs-target="#modal-add-category">
                                                    <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                                                    Add Category
                                                </button>
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
            <!-- /.table-responsive -->
        </div>
    </div>

    <!--begin::Add User Modal-->
    <div class="modal fade" id="modal-add-category" tabindex="-1" aria-labelledby="modal-add-category-label"
        aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/api/category" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modal-add-category-label">Add new Category</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="categoryName" class="form-label">Category Name</label>
                            <input type="text" class="form-control" name="categoryName"
                                placeholder="Enter Category Name" required />
                        </div>
                        <div class="mb-3">
                            <label for="categoryCode" class="form-label">Category Code</label>
                            <input type="text" class="form-control" name="categoryCode"
                                placeholder="Enter Category Code" required />
                        </div>
                        <div class="mb-3">
                            <label for="categoryDetail" class="form-label">Category Detail</label>
                            <input type="text" class="form-control" name="categoryDetail"
                                placeholder="Enter Category Detail" required />
                        </div>
                        <div class="mb-3">
                            <label for="categoryImage" class="form-label">Category Image</label>
                            <input type="text" class="form-control" name="categoryImage"
                                placeholder="Enter Category Image" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary">Create Category</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!--end::Add User Modal-->

    <%- include("../partials/Footer.ejs") %>



