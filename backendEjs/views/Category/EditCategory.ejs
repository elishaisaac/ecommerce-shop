<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Category</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-6">

                <!-- Form Card -->
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h3 class="fw-bold mb-1">
                            Edit Category
                        </h3>
                        <p class="text-muted mb-4">
                            Enter the Category information below.
                        </p>
                        <form action="/api/category/updateCategory/<%= category._id %>" method="post">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Category Name
                                </label>
                                <input type="text" class="form-control" name="categoryName" required value="<%=category.categoryName %>">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Category Code
                                </label>
                                <input type="text" class="form-control" name="categoryCode" required value="<%=category.categoryCode %>">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Category Detail
                                </label>
                                <input type="text" class="form-control" name="categoryDetail" required value="<%=category.categoryDetail %>">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Category Image
                                </label>
                                <input type="text" class="form-control" name="categoryImage" required value="<%=category.categoryImage %>">
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-success">
                                    Save
                                </button>
                                <a href="/api/category" class="btn btn-secondary">
                                    Cancel
                                </a>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>

</body>

</html>