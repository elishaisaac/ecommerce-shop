<%- include("../partials/HeadSection.ejs") %>
    <div class="card mb-4">
        <div class="card-header">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <h3 class="card-title">OrderDiscount List</h3>
                </div>
                <div class="col-12 col-md-8">
                    <div class="d-flex flex-wrap justify-content-md-end gap-2">
                        <div class="input-group input-group-sm w-auto">
                            <span class="input-group-text">
                                <i class="bi bi-search" aria-hidden="true"></i>
                            </span>
                            <input type="search" id="user-search" class="form-control" placeholder="Search OrderDiscounts"
                                aria-label="Search users" style="width: 180px" />
                        </div>
                        <select id="user-role-filter" class="form-select form-select-sm w-auto"
                            aria-label="Filter by role">
                            <option value="all" selected>All roles</option>
                            <option value="administrator">Administrator</option>
                            <option value="editor">Editor</option>
                            <option value="author">Author</option>
                            <option value="subscriber">Subscriber</option>
                        </select>
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#modal-add-orderDiscount">
                            <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                            New OrderDiscount
                        </button>
                        <!-- data-bs-toggle="modal" -->
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Order Number</th>
                            <th>Coupon Code</th>
                            <th>Discount Amount</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data.length> 0) { %>
                            <% data.forEach((item, index)=> { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <%= index + 1 %>
                                        </div>
                                    </td>
                                    <td>
                                        <%= item.orderFID.orderNumber %>
                                    </td>
                                    <td>
                                        <%= item.couponFID.couponCode %>
                                    </td>
                                    <td>
                                        <%= item.discountAmount %>
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modal-edit-orderDiscount-<%= item._id %>">
                                                <i class="bi bi-pencil" aria-hidden="true"> </i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal"
                                                data-bs-target="#modal-delete-orderDiscount-<%= item._id %>">
                                                <i class="bi bi-trash" aria-hidden="true"> </i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <!--begin::Edit OrderDiscount Modal-->
                                <div class="modal fade" id="modal-edit-orderDiscount-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-edit-orderDiscount-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form action="/api/orderDiscount/updateorderDiscount/<%= item._id %>" method="post">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="modal-edit-orderDiscount-label">Edit
                                                        OrderDiscount</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                        aria-label="Close"></button>
                                                </div>

                                                <div class="modal-body">
                                                   <div class="mb-3">
                                                        <label for="orderFID" class="form-label"> Order Number
                                                        </label>
                                                        <select id="new-orderDiscount-order" name="orderFID"
                                                            class="form-select">
                                                            <option value="<%= item.orderFID._id%>" selected>
                                                                <%= item.orderFID.orderNumber %>
                                                            </option>
                                                            <% Orders.forEach((order)=> {%>
                                                                <option value="<%= order._id%>">
                                                                    <%= order.orderNumber %>
                                                                </option>
                                                                <%})%>
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="couponFID" class="form-label"> Coupon Code
                                                        </label>
                                                        <select id="new-orderDiscount-coupon" name="couponFID"
                                                            class="form-select">
                                                            <option value="<%= item.couponFID._id%>" selected>
                                                                <%= item.couponFID.couponCode %>
                                                            </option>
                                                            <% Coupons.forEach((coupon)=> {%>
                                                                <option value="<%= coupon._id%>">
                                                                    <%= coupon.couponCode %>
                                                                </option>
                                                                <%})%>
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="discountAmount" class="form-label">Discount
                                                            Amount</label>
                                                        <input type="number" step="0.01" class="form-control" name="discountAmount"
                                                            value="<%= item.discountAmount %>" required />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary"
                                                        data-bs-dismiss="modal">
                                                        Cancel
                                                    </button>
                                                    <button type="submit" class="btn btn-primary">Update
                                                        OrderDiscount</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Edit OrderDiscount Modal-->

                                <!--begin::Delete OrderDiscount Modal-->
                                <div class="modal fade" id="modal-delete-orderDiscount-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-delete-orderDiscount-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="modal-delete-orderDiscount-label">Delete OrderDiscount
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                    aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="mb-0">
                                                    Are you sure you want to delete this OrderDiscount?
                                                    This action cannot be undone.
                                                </p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    Cancel
                                                </button>
                                                <form action="/api/orderDiscount/deleteorderDiscount/<%= item._id %>" method="post">
                                                    <button type="submit" class="btn btn-danger"
                                                        data-bs-dismiss="modal">
                                                        Delete OrderDiscount
                                                    </button>
                                                </form>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Delete OrderDiscount Modal-->
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="5" class="text-center py-5">
                                                <h5 class="text-muted">
                                                    No OrderDiscount Found
                                                </h5>
                                                <p class="text-muted mb-3">
                                                    Start by adding your first OrderDiscount.
                                                </p>
                                                <button type="button" class="btn btn-sm btn-primary"
                                                    data-bs-toggle="modal" data-bs-target="#modal-add-orderDiscount">
                                                    <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                                                    Add OrderDiscount
                                                </button>
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
            <!-- /.table-responsive -->
        </div>
    </div>

    <!--begin::Add OrderDiscount Modal-->
    <div class="modal fade" id="modal-add-orderDiscount" tabindex="-1" aria-labelledby="modal-add-orderDiscount-label"
        aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/api/orderDiscount" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modal-add-orderDiscount-label">Add new OrderDiscount</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <div class="mb-3">
                                <label for="orderFID" class="form-label"> Order Number </label>
                                <select id="new-orderDiscount-order" name="orderFID" class="form-select">
                                    <option selected>Select Order</option>
                                    <% Orders.forEach((order)=> {%>
                                        <option value="<%= order._id%>">
                                            <%= order.orderNumber %>
                                        </option>
                                        <%})%>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="mb-3">
                                <label for="couponFID" class="form-label"> Coupon Code </label>
                                <select id="new-orderDiscount-coupon" name="couponFID" class="form-select">
                                    <option selected>Select Coupon</option>
                                    <% Coupons.forEach((coupon)=> {%>
                                        <option value="<%= coupon._id%>">
                                            <%= coupon.couponCode %>
                                        </option>
                                        <%})%>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="discountAmount" class="form-label">Discount Amount</label>
                            <input type="number" step="0.01" class="form-control" name="discountAmount"
                                placeholder="Enter Discount Amount" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary">Create OrderDiscount</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!--end::Add OrderDiscount Modal-->

    <%- include("../partials/Footer.ejs") %>
