<%- include("../partials/HeadSection.ejs") %>
    <div class="card mb-4">
        <div class="card-header">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <h3 class="card-title">Order List</h3>
                </div>
                <div class="col-12 col-md-8">
                    <div class="d-flex flex-wrap justify-content-md-end gap-2">
                        <div class="input-group input-group-sm w-auto">
                            <span class="input-group-text">
                                <i class="bi bi-search" aria-hidden="true"></i>
                            </span>
                            <input type="search" id="user-search" class="form-control" placeholder="Search Orders"
                                aria-label="Search users" style="width: 180px" />
                        </div>
                        <select id="user-role-filter" class="form-select form-select-sm w-auto"
                            aria-label="Filter by role">
                            <option value="all" selected>All roles</option>
                            <option value="administrator">Administrator</option>
                            <option value="editor">Editor</option>
                            <option value="author">Author</option>
                            <option value="subscriber">Subscriber</option>
                        </select>
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#modal-add-order">
                            <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                            New Order
                        </button>
                        <!-- data-bs-toggle="modal" -->
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Order Number</th>
                            <th>User Email</th>
                            <th>Order Status</th>
                            <th>Order Total</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data.length> 0) { %>
                            <% data.forEach((item, index)=> { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <%= index + 1 %>
                                        </div>
                                    </td>
                                    <td>
                                        <%= item.orderNumber %>
                                    </td>
                                    <td>
                                        <%= item.userFID?.userEmail || item.customerEmail || "Guest" %>
                                    </td>
                                    <td>
                                        <%= item.orderStatus %>
                                    </td>
                                    <td>
                                        <%= item.orderTotal %>
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modal-edit-order-<%= item._id %>">
                                                <i class="bi bi-pencil" aria-hidden="true"> </i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal"
                                                data-bs-target="#modal-delete-order-<%= item._id %>">
                                                <i class="bi bi-trash" aria-hidden="true"> </i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <!--begin::Edit Order Modal-->
                                <div class="modal fade" id="modal-edit-order-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-edit-order-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form action="/api/order/updateorder/<%= item._id %>" method="post">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="modal-edit-order-label">Edit
                                                        Order</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                        aria-label="Close"></button>
                                                </div>

                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label for="userFID" class="form-label"> User Email
                                                        </label>
                                                        <select id="new-order-role" name="userFID" class="form-select">
                                                            <option value="<%= item.userFID?._id || '' %>" selected>
                                                                <%= item.userFID?.userEmail || item.customerEmail
                                                                    || "Guest" %>
                                                            </option>
                                                            <% Users.forEach((user)=> {%>
                                                                <option value="<%= user._id%>">
                                                                    <%= user.userEmail %>
                                                                </option>
                                                                <%})%>
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="orderNumber" class="form-label">Order
                                                            Number</label>
                                                        <input type="text" class="form-control" name="orderNumber"
                                                            value="<%= item.orderNumber %>" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="orderStatus" class="form-label">Order
                                                            Status</label>
                                                        <select id="new-order-status" name="orderStatus"
                                                            class="form-select">
                                                            <% ["Pending", "Processing" , "Shipped" , "Delivered"
                                                                , "Cancelled" , "Returned" ].forEach((status)=> { %>
                                                                <option value="<%= status %>"
                                                                    <%=item.orderStatus===status ? "selected" : "" %>>
                                                                    <%= status %>
                                                                </option>
                                                                <% }) %>
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="orderTotal" class="form-label">Order
                                                            Total</label>
                                                        <input type="number" step="0.01" class="form-control"
                                                            name="orderTotal" value="<%= item.orderTotal %>" required />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary"
                                                        data-bs-dismiss="modal">
                                                        Cancel
                                                    </button>
                                                    <button type="submit" class="btn btn-primary">Update
                                                        Order</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Edit Order Modal-->

                                <!--begin::Delete Order Modal-->
                                <div class="modal fade" id="modal-delete-order-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-delete-order-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="modal-delete-order-label">Delete Order
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                    aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="mb-0">
                                                    Are you sure you want to delete this Order?
                                                    This action cannot be undone.
                                                </p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    Cancel
                                                </button>
                                                <form action="/api/order/deleteorder/<%= item._id %>" method="post">
                                                    <button type="submit" class="btn btn-danger"
                                                        data-bs-dismiss="modal">
                                                        Delete Order
                                                    </button>
                                                </form>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Delete Order Modal-->
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="text-center py-5">
                                                <h5 class="text-muted">
                                                    No Order Found
                                                </h5>
                                                <p class="text-muted mb-3">
                                                    Start by adding your first Order.
                                                </p>
                                                <button type="button" class="btn btn-sm btn-primary"
                                                    data-bs-toggle="modal" data-bs-target="#modal-add-order">
                                                    <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                                                    Add Order
                                                </button>
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
            <!-- /.table-responsive -->
        </div>
    </div>

    <!--begin::Add Order Modal-->
    <div class="modal fade" id="modal-add-order" tabindex="-1" aria-labelledby="modal-add-order-label"
        aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/api/order" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modal-add-order-label">Add new Order</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <div class="mb-3">
                                <label for="userFID" class="form-label"> User Email </label>
                                <select id="new-order-role" name="userFID" class="form-select">
                                    <option selected>Select User Email</option>
                                    <% Users.forEach((user)=> {%>
                                        <option value="<%= user._id%>">
                                            <%= user.userEmail %>
                                        </option>
                                        <%})%>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="orderNumber" class="form-label">Order Number</label>
                            <input type="text" class="form-control" name="orderNumber" placeholder="Enter Order Number"
                                required />
                        </div>
                        <div class="mb-3">
                            <label for="orderStatus" class="form-label">Order Status</label>
                            <select id="new-order-status" name="orderStatus" class="form-select">
                                <% ["Pending", "Processing" , "Shipped" , "Delivered" , "Cancelled" , "Returned"
                                    ].forEach((status)=> { %>
                                    <option value="<%= status %>" <%=status==="Pending" ? "selected" : "" %>>
                                        <%= status %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="orderTotal" class="form-label">Order Total</label>
                            <input type="number" step="0.01" class="form-control" name="orderTotal"
                                placeholder="Enter Order Total" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary">Create Order</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!--end::Add Order Modal-->

    <%- include("../partials/Footer.ejs") %>