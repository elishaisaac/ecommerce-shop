<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Product</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-6">

                <!-- Form Card -->
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h3 class="fw-bold mb-1">
                            Edit Product
                        </h3>
                        <p class="text-muted mb-4">
                            Enter the Product information below.
                        </p>
                        <form action="/api/product/updateProduct/<%= product._id %>" method="post">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Product Name
                                </label>
                                <input type="text" class="form-control" name="productName" required value="<%= product.productName %>">
                            </div>
                            <!-- <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Category ID
                                </label>
                                <input type="text" class="form-control" name="categoryFID" required value="<%= product.categoryFID %>">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Brand ID
                                </label>
                                <input type="text" class="form-control" name="brandFID" required value="<%= product.brandFID %>">
                            </div> -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Product Description
                                </label>
                                <input type="text" class="form-control" name="productDesc" required value="<%= product.productDesc %>">
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-success">
                                    Update
                                </button>
                                <a href="/api/product" class="btn btn-secondary">
                                    Cancel
                                </a>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>

</body>

</html>