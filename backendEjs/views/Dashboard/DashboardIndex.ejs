<%- include("../partials/HeadSection.ejs") %>

<%
    const badge = {
        Pending: "warning",
        Processing: "info",
        Shipped: "primary",
        Delivered: "success",
        Cancelled: "danger",
        Returned: "secondary"
    }
    const money = (n) => "Rs. " + Number(n || 0).toLocaleString()
    const statusTotal = statusCounts.reduce((sum, s) => sum + s.count, 0) || 1
%>

<style>
    .dash-bars { display: flex; align-items: flex-end; gap: 10px; height: 180px; }
    .dash-bar-col { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; height: 100%; }
    .dash-bar { width: 100%; max-width: 46px; background: var(--bs-primary); border-radius: 6px 6px 0 0; min-height: 3px; }
    .dash-bar-label { font-size: 12px; margin-top: 6px; color: var(--bs-secondary-color); }
</style>

<div class="row g-3 mb-3">
    <div class="col-12 col-lg">
        <div class="card mb-3 h-100">
            <div class="card-body">
                <div class="text-secondary small">Sales</div>
                <div class="fs-4 fw-bold"><%= money(revenue) %></div>
                <div class="text-secondary small">excl. cancelled &amp; returned</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="card mb-3 h-100">
            <div class="card-body">
                <div class="text-secondary small">Orders</div>
                <div class="fs-4 fw-bold"><%= totalOrders %></div>
                <div class="text-secondary small">all time</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="card mb-3 h-100">
            <div class="card-body">
                <div class="text-secondary small">Average order</div>
                <div class="fs-4 fw-bold"><%= money(averageOrder) %></div>
                <div class="text-secondary small">per order</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="card mb-3 h-100">
            <div class="card-body">
                <div class="text-secondary small">Products</div>
                <div class="fs-4 fw-bold"><%= productCount %></div>
                <div class="text-secondary small">in catalog</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="card mb-3 h-100">
            <div class="card-body">
                <div class="text-secondary small">Customers</div>
                <div class="fs-4 fw-bold"><%= customerCount %></div>
                <div class="text-secondary small">unique emails</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header"><h3 class="card-title">Sales, last 7 days</h3></div>
            <div class="card-body">
                <div class="dash-bars">
                    <% days.forEach(d => { %>
                        <% const h = Math.max(Math.round((d.total / maxDay) * 100), d.total > 0 ? 4 : 0) %>
                        <div class="dash-bar-col" title="<%= d.label %>: <%= money(d.total) %>">
                            <div class="dash-bar" style="height: <%= h %>%"></div>
                            <div class="dash-bar-label"><%= d.label %></div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header"><h3 class="card-title">Orders by status</h3></div>
            <div class="card-body">
                <% statusCounts.forEach(s => { %>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="badge text-bg-<%= badge[s.status] %>"><%= s.status %></span>
                            <strong><%= s.count %></strong>
                        </div>
                        <div class="progress" style="height: 6px">
                            <div class="progress-bar bg-<%= badge[s.status] %>"
                                style="width: <%= Math.round((s.count / statusTotal) * 100) %>%"></div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-7">
        <div class="card mb-4">
            <div class="card-header">
                <h3 class="card-title">Recent orders</h3>
                <div class="card-tools"><a href="/api/order">View all</a></div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle m-0">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Customer</th>
                                <th>Status</th>
                                <th class="text-end">Total</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (recentOrders.length === 0) { %>
                                <tr><td colspan="5" class="text-center text-secondary py-4">No orders yet</td></tr>
                            <% } %>
                            <% recentOrders.forEach(o => { %>
                                <tr>
                                    <td><a href="/api/order/<%= o._id %>/details"><%= o.orderNumber %></a></td>
                                    <td><%= o.customerName || o.userFID?.userEmail || "-" %></td>
                                    <td><span class="badge text-bg-<%= badge[o.orderStatus] || 'secondary' %>"><%= o.orderStatus %></span></td>
                                    <td class="text-end"><%= money(o.orderTotal) %></td>
                                    <td><%= new Date(o.createdAt).toLocaleDateString() %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-header"><h3 class="card-title">Top selling products</h3></div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle m-0">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th class="text-end">Units</th>
                                <th class="text-end">Sales</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (topProducts.length === 0) { %>
                                <tr><td colspan="3" class="text-center text-secondary py-4">No sales yet</td></tr>
                            <% } %>
                            <% topProducts.forEach(p => { %>
                                <tr>
                                    <td><%= p.name %></td>
                                    <td class="text-end"><%= p.units %></td>
                                    <td class="text-end"><%= money(p.total) %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include("../partials/Footer.ejs") %>