<%- include("../partials/HeadSection.ejs") %>
    <div class="card mb-4">
        <div class="card-header">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <h3 class="card-title">Product Attributes List</h3>
                </div>
                <div class="col-12 col-md-8">
                    <div class="d-flex flex-wrap justify-content-md-end gap-2">
                        <div class="input-group input-group-sm w-auto">
                            <span class="input-group-text">
                                <i class="bi bi-search" aria-hidden="true"></i>
                            </span>
                            <input type="search" id="user-search" class="form-control" placeholder="Search Product Attributes"
                                aria-label="Search users" style="width: 180px" />
                        </div>
                                                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#modal-add-productAttribute">
                            <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                            New Product Attributes
                        </button>
                        <!-- data-bs-toggle="modal" -->
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle m-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Product Name</th>
                            <th>Attribute Name</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data.length> 0) { %>
                            <% data.forEach((item, index)=> { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <%= index + 1 %>
                                        </div>
                                    </td>
                                    <td>
                                        <%= item.productFID.productName %>
                                    </td>
                                    <td>
                                        <%= item.attributeFID.attributeName %>
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modal-edit-productAttribute-<%= item._id %>">
                                                <i class="bi bi-pencil" aria-hidden="true"> </i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal"
                                                data-bs-target="#modal-delete-productAttribute-<%= item._id %>">
                                                <i class="bi bi-trash" aria-hidden="true"> </i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <!--begin::Edit Product Attribute Modal-->
                                <div class="modal fade" id="modal-edit-productAttribute-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-edit-productAttribute-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form action="/api/productAttribute/updateproductAttribute/<%= item._id %>" method="post">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="modal-edit-productAttribute-label">Edit
                                                        Product</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                        aria-label="Close"></button>
                                                </div>

                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label for="productFID" class="form-label"> Product Name
                                                        </label>
                                                        <select id="new-user-role" name="productFID"
                                                            class="form-select">
                                                            <option value="<%= item.productFID._id%>" selected>
                                                                <%= item.productFID.productName %>
                                                            </option>
                                                            <% Products.forEach((product)=> {%>
                                                                <option value="<%= product._id%>">
                                                                    <%= product.productName%>
                                                                </option>
                                                                <%})%>
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label for="attributeFID" class="form-label"> Attribute Name
                                                        </label>
                                                        <select id="new-user-role" name="attributeFID"
                                                            class="form-select">
                                                            <option value="<%= item.attributeFID._id%>" selected>
                                                                <%= item.attributeFID.attributeName %>
                                                            </option>
                                                            <% Attributes.forEach((attribute)=> {%>
                                                                <option value="<%= attribute._id%>">
                                                                    <%= attribute.attributeName%>
                                                                </option>
                                                                <%})%>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary"
                                                        data-bs-dismiss="modal">
                                                        Cancel
                                                    </button>
                                                    <button type="submit" class="btn btn-primary">Update
                                                        Product Attribute</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Edit Product Modal-->

                                <!--begin::Delete Product Modal-->
                                <div class="modal fade" id="modal-delete-productAttribute-<%= item._id %>" tabindex="-1"
                                    aria-labelledby="modal-delete-productAttribute-label" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="modal-delete-productAttribute-label">Delete Product
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                    aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="mb-0">
                                                    Are you sure you want to delete this Product?
                                                    This action cannot be undone.
                                                </p>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    Cancel
                                                </button>
                                                <form action="/api/productAttribute/deleteproductAttribute/<%= item._id %>" method="post">
                                                    <button type="submit" class="btn btn-danger"
                                                        data-bs-dismiss="modal">
                                                        Delete Product
                                                    </button>
                                                </form>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!--end::Delete Product Modal-->
                                <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="text-center py-5">
                                                <h5 class="text-muted">
                                                    No Product Found
                                                </h5>
                                                <p class="text-muted mb-3">
                                                    Start by adding your first Product.
                                                </p>
                                                <button type="button" class="btn btn-sm btn-primary"
                                                    data-bs-toggle="modal" data-bs-target="#modal-add-productAttribute">
                                                    <i class="bi bi-person-plus-fill me-1" aria-hidden="true"> </i>
                                                    Add Product
                                                </button>
                                            </td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>
            <!-- /.table-responsive -->
        </div>
    </div>

    <!--begin::Add User Modal-->
    <div class="modal fade" id="modal-add-productAttribute" tabindex="-1" aria-labelledby="modal-add-productAttribute-label"
        aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="/api/productAttribute" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modal-add-product-label">Add new Product Attribute</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="productFID" class="form-label"> Product Name </label>
                            <select id="new-user-role" name="productFID" class="form-select">
                                <option selected>Select Product Name</option>
                                <% Products.forEach((product)=> {%>
                                    <option value="<%= product._id%>">
                                        <%= product.productName %>
                                    </option>
                                    <%})%>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="attributeFID" class="form-label"> Attribute Name </label>
                            <select id="new-user-role" name="attributeFID" class="form-select">
                                <option selected>Select Product Name</option>
                                <% Attributes.forEach((attribute)=> {%>
                                    <option value="<%= attribute._id%>">
                                        <%= attribute.attributeName %>
                                    </option>
                                    <%})%>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary">Create Product Attribute</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!--end::Add User Modal-->

    <%- include("../partials/Footer.ejs") %>